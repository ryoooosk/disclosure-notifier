{
  "name": "disclosure-notifier",
  "version": "1.0.0",
  "description": "TDnet の適時開示と EDINET の法定開示をウォッチリストで絞ってメール通知する",
  "main": "index.js",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "check": "biome check --write --no-errors-on-unmatched",
    "lint": "biome lint --write",
    "format": "biome format --write",
    "biome:ci": "biome ci",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "keywords": [],
  "author": "ryoooosk",
  "license": "UNLICENSED",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^26.6.4",
    "lefthook": "^2.1.17",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cheerio": "^1.2.0",
    "jsonc-parser": "^3.3.1",
    "resend": "^6.32.0",
    "zod": "^4.6.5"
  }
}
